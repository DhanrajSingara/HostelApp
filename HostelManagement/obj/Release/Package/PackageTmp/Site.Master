<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="HostelManagement.SiteMaster" %>

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head runat="server">
    <script>
        // Apply saved theme before paint to avoid a flash of the wrong theme.
        (function () {
            var saved = localStorage.getItem('hms-theme') || 'light';
            document.documentElement.setAttribute('data-theme', saved);
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> | Hostel Management</title>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
    <style>
        /* ---------- Theme tokens ---------- */
        :root {
            --bg: #f3f4f6;
            --sidebar-bg: #ffffff;
            --card-bg: #ffffff;
            --text: #1f2937;
            --text-muted: #6b7280;
            --border: #e5e7eb;
            --primary: #7c3aed;
            --primary-grad: linear-gradient(135deg,#4f46e5,#9333ea);
            --hover: #f5f3ff;
            --topbar-bg: #ffffff;
            --shadow: 0 1px 3px rgba(0,0,0,.08);
        }

        [data-theme="dark"] {
            --bg: #0f172a;
            --sidebar-bg: #1e293b;
            --card-bg: #1e293b;
            --text: #e2e8f0;
            --text-muted: #94a3b8;
            --border: #334155;
            --primary: #a78bfa;
            --primary-grad: linear-gradient(135deg,#6366f1,#a855f7);
            --hover: #293548;
            --topbar-bg: #1e293b;
            --shadow: 0 1px 3px rgba(0,0,0,.4);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: var(--bg);
            color: var(--text);
            transition: background .25s, color .25s;
        }

        /* ---------- Sidebar ---------- */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 250px;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            transition: transform .25s, background .25s;
            z-index: 100;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 20px 22px;
            border-bottom: 1px solid var(--border);
        }

            .brand .logo {
                width: 42px;
                height: 42px;
                border-radius: 11px;
                background: var(--primary-grad);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                color: #fff;
            }

            .brand .title {
                font-size: 17px;
                font-weight: 700;
                color: var(--text);
            }

                .brand .title small {
                    display: block;
                    font-size: 11px;
                    font-weight: 500;
                    color: var(--text-muted);
                }

        .nav {
            flex: 1;
            overflow-y: auto;
            padding: 14px 12px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            margin-bottom: 4px;
            border-radius: 10px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all .18s ease;
        }

            .nav-item svg {
                width: 20px;
                height: 20px;
                flex-shrink: 0;
            }

            .nav-item:hover {
                background: var(--hover);
                color: var(--primary);
            }

            .nav-item.active {
                background: var(--primary-grad);
                color: #fff;
                box-shadow: 0 6px 16px rgba(124,58,237,.3);
            }

        /* ---------- Top bar ---------- */
        .topbar {
            position: sticky;
            top: 0;
            height: 82px;
            margin-left: 250px;
            background: var(--topbar-bg);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            padding: 0 24px;
            gap: 16px;
            z-index: 90;
            transition: background .25s;
            box-shadow: var(--shadow);
        }

        .hamburger {
            display: none;
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text);
            font-size: 22px;
            line-height: 1;
        }

        .page-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--text);
        }

        .spacer {
            flex: 1;
        }

        .branch-chip {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 7px 13px;
            border-radius: 9px;
            background: var(--hover);
            color: var(--primary);
            font-size: 13px;
            font-weight: 600;
        }

        .theme-btn {
            background: var(--hover);
            border: 1px solid var(--border);
            width: 40px;
            height: 40px;
            border-radius: 10px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text);
            transition: all .2s;
        }

            .theme-btn:hover {
                border-color: var(--primary);
                color: var(--primary);
            }

            .theme-btn svg {
                width: 20px;
                height: 20px;
            }

        /* notification bell */
        .notif-btn {
            position: relative;
            background: var(--hover);
            border: 1px solid var(--border);
            width: 40px;
            height: 40px;
            border-radius: 10px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text);
            text-decoration: none;
            transition: all .2s;
        }

            .notif-btn:hover {
                border-color: var(--primary);
                color: var(--primary);
            }

            .notif-btn svg {
                width: 20px;
                height: 20px;
            }

        .notif-badge {
            position: absolute;
            top: -6px;
            right: -6px;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            border-radius: 9px;
            background: #dc2626;
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

        [data-theme="light"] .moon-icon {
            display: none;
        }

        [data-theme="dark"] .sun-icon {
            display: none;
        }

        .user-box {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--primary-grad);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 15px;
        }

        .user-meta {
            line-height: 1.2;
        }

            .user-meta .name {
                font-size: 13px;
                font-weight: 600;
                color: var(--text);
            }

            .user-meta .role {
                font-size: 11px;
                color: var(--text-muted);
            }

        .logout-btn {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 10px;
            transition: all .2s;
        }

            .logout-btn svg {
                width: 20px;
                height: 20px;
            }

            .logout-btn:hover {
                color: #dc2626;
                background: rgba(220,38,38,.08);
            }

        /* ---------- Main content ---------- */
        .content {
            margin-left: 250px;
            padding: 26px;
            min-height: calc(100vh - 82px);
            display: flex;
            flex-direction: column;
        }

        .content-inner {
            flex: 1;
        }

        .app-footer {
            margin-top: 26px;
            padding-top: 16px;
            border-top: 1px solid var(--border);
            text-align: center;
            font-size: 12.5px;
            color: var(--text-muted);
        }

        /* ---------- Responsive ---------- */
        @media (max-width:768px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .topbar, .content {
                margin-left: 0;
            }

            .hamburger {
                display: block;
            }

            .branch-chip, .user-meta {
                display: none;
            }
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">

        <!-- ============ SIDEBAR ============ -->
        <aside class="sidebar" id="sidebar">
            <div class="brand">
                <div class="logo">&#127970;</div>
                <div class="title">Hostel MS<small>Management System</small></div>
            </div>
            <nav class="nav">
                <a href="Dashboard.aspx" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                    </svg>
                    <span>Dashboard</span>
                </a>
                <a href="Rooms.aspx" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                    <span>Rooms</span>
                </a>
                <a href="BedAllocation.aspx" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 18v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6" />
                        <line x1="3" y1="14" x2="21" y2="14" />
                        <path d="M7 10V8a1 1 0 0 1 1-1h3v3" />
                        <line x1="3" y1="18" x2="3" y2="21" />
                        <line x1="21" y1="18" x2="21" y2="21" />
                    </svg>
                    <span>Beds Allocation</span>
                </a>

                <%-- <a href="Billing.aspx" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                    <span>Billing</span>
                </a> --%>
                <a href="Receipts.aspx" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                        <line x1="10" y1="9" x2="8" y2="9" />
                    </svg>
                    <span>Payments</span>
                </a>

                <a href="Expenses.aspx" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4" />
                        <path d="M3 5v14a2 2 0 0 0 2 2h16v-5" />
                        <path d="M18 12a2 2 0 0 0 0 4h4v-4z" />
                    </svg>
                    <span>Expenses</span>
                </a>

                <a href="Reports.aspx" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="6" y1="20" x2="6" y2="14" />
                        <line x1="12" y1="20" x2="12" y2="4" />
                        <line x1="18" y1="20" x2="18" y2="10" />
                    </svg>
                    <span>Reports</span>
                </a>
                <a href="HostelInfo.aspx" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18" />
                        <line x1="2" y1="22" x2="22" y2="22" />
                        <line x1="10" y1="7" x2="14" y2="7" />
                        <line x1="10" y1="11" x2="14" y2="11" />
                        <line x1="10" y1="15" x2="14" y2="15" />
                    </svg>
                    <span>Hostel Info</span>
                </a>
                <a href="Staff.aspx" class="nav-item" runat="server" id="navStaff">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    <span>Staff</span>
                </a>
                <a href="Settings.aspx" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                    </svg>
                    <span>Settings</span>
                </a>
                <a href="Guidelines.aspx" class="nav-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="16" x2="12" y2="12" />
                        <line x1="12" y1="8" x2="12.01" y2="8" />
                    </svg>
                    <span>Guidelines</span>
                </a>


            </nav>
        </aside>

        <!-- ============ TOP BAR ============ -->
        <header class="topbar">
            <button type="button" class="hamburger" onclick="toggleSidebar()">&#9776;</button>
            <span class="page-title"><%: Page.Title %></span>
            <div class="spacer"></div>

            <div class="branch-chip">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 21h18" />
                    <path d="M5 21V7l8-4v18" />
                    <path d="M19 21V11l-6-4" />
                </svg>
                <asp:Literal ID="litBranch" runat="server"></asp:Literal>
            </div>

            <a href="Dashboard.aspx" class="notif-btn" title="Pending payments">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                    <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                </svg>
                <asp:Literal ID="litNotif" runat="server"></asp:Literal>
            </a>

            <button type="button" class="theme-btn" onclick="toggleTheme()" title="Toggle theme">
                <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5" />
                    <line x1="12" y1="1" x2="12" y2="3" />
                    <line x1="12" y1="21" x2="12" y2="23" />
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
                    <line x1="1" y1="12" x2="3" y2="12" />
                    <line x1="21" y1="12" x2="23" y2="12" />
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
                </svg>
                <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                </svg>
            </button>

            <div class="user-box">
                <div class="user-avatar">
                    <asp:Literal ID="litInitial" runat="server"></asp:Literal>
                </div>
                <div class="user-meta">
                    <div class="name">
                        <asp:Literal ID="litUser" runat="server"></asp:Literal>
                    </div>
                    <div class="role">
                        <asp:Literal ID="litRole" runat="server"></asp:Literal>
                    </div>
                </div>
            </div>

            <asp:LinkButton ID="btnLogout" runat="server" CssClass="logout-btn"
                OnClick="btnLogout_Click" ToolTip="Sign out">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>
            </asp:LinkButton>
        </header>

        <!-- ============ PAGE CONTENT ============ -->
        <main class="content">
            <div class="content-inner">
                <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
            </div>
            <footer class="app-footer">
                &copy; <%= DateTime.Now.Year %> Hostel Management System. All rights reserved.
                &nbsp;|&nbsp; Designed &amp; developed by #YuvaTeam.
           
            </footer>
        </main>

    </form>

    <script>
        function toggleTheme() {
            var cur = document.documentElement.getAttribute('data-theme');
            var next = cur === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('hms-theme', next);
        }

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
        }

        // Highlight the current page in the sidebar.
        (function () {
            var path = window.location.pathname.split('/').pop().toLowerCase();
            var links = document.querySelectorAll('.nav-item');
            links.forEach(function (a) {
                var href = a.getAttribute('href').toLowerCase();
                if (href === path) a.classList.add('active');
            });
        })();
    </script>
</body>
</html>
